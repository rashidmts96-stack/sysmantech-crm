# Disable directory listing
Options -Indexes

# Enable Passenger (Python App) - cPanel sets this automatically
# PassengerEnabled on

# Direct all requests to the Flask app (Passenger handles routing)
# If you get 404s on sub-pages, uncomment the lines below:
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.*)$ /passenger_wsgi.py/$1 [QSA,L]
